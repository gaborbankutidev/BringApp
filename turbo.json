{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"//#lint:root": {},
		"build": {
			"dependsOn": ["^build", "^types", "^lint"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/", "template/"]
		},
		"@bring/bring-app#build": {
			"dependsOn": ["^build", "@bring/blocks-client#build", "@bring/blocks-editor#build"],
			"cache": false
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"types": {
			"dependsOn": ["^types"]
		},
		"test": {
			"dependsOn": ["^test", "^lint", "^types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
